AMNEZIA_PANEL_SECRET=replace-with-at-least-32-random-characters
AMNEZIA_PANEL_ADMIN=admin
AMNEZIA_PANEL_PASSWORD_HASH=$argon2id$replace-with-generated-hash
AMNEZIA_PANEL_DB=/var/lib/amnezia-panel/panel.db
AMNEZIA_PANEL_CONFIG=/etc/amnezia/amneziawg/awg0.conf
AMNEZIA_PANEL_CLIENTS=/root/awg
AMNEZIA_PANEL_AWG=awg
AMNEZIA_PANEL_AWG_QUICK=awg-quick
AMNEZIA_PANEL_INTERFACE=awg0
AMNEZIA_PANEL_ENDPOINT=SERVER_IP:PORT
AMNEZIA_PANEL_DNS=1.1.1.1
AMNEZIA_PANEL_SESSION_TIMEOUT=1800
AMNEZIA_PANEL_ADD_HELPER=/usr/local/sbin/amnezia-panel-add
AMNEZIA_PANEL_REGEN_HELPER=/usr/local/sbin/amnezia-panel-regen
